DATABASE_URL=sqlite+aiosqlite:///./aven.db

# ─── LLM Provider Keys ───────────────────────────────────────────────────────
# Fallback priority: Ollama (local) → Groq → Gemini → OpenAI → Anthropic → mock
# Add the keys for any providers you want to use. Only one is required.

# 1. Groq — ultra-fast inference (RECOMMENDED: free tier available)
GROQ_API_KEY=your_groq_api_key_here

# 2. Gemini — Google AI
# GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenAI — GPT-4o series
# OPENAI_API_KEY=your_openai_api_key_here

# 4. Anthropic — Claude series
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Model Overrides (optional) ──────────────────────────────────────────────
# Override the default model for each provider. Defaults shown below.
# Groq production models (do NOT use deprecated/preview IDs):
#   openai/gpt-oss-20b       ← default, fast + efficient
#   openai/gpt-oss-120b      ← highest reasoning
#   llama-3.3-70b-versatile  ← general purpose
#   llama-3.1-8b-instant     ← ultra-fast
GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ─── Local Ollama (no key needed, runs locally) ───────────────────────────────
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
